NODE_ENV=development
PORT=5000

# Use DATABASE_URL on managed PostgreSQL hosts, or the separate DB_* values below.
# DATABASE_URL=postgres://user:password@host:5432/database
# DB_SSL=true
DB_HOST=localhost
DB_PORT=5432
DB_NAME=FabricsDb
DB_USER=postgres
DB_PASSWORD=change_me

# Production CORS should allow only the deployed frontend domain.
FRONTEND_URL=https://stageware.co.uk
# BACKEND_URL=https://api.stageware.co.uk

WHATSAPP_UK_NUMBER=447700900123
WHATSAPP_DEFAULT_TEXT=Hello, I need some help with your products.

# Required to enable write endpoints:
# POST /api/categories
# POST /api/subcategories
# PUT /api/subcategories/:id
# DELETE /api/subcategories/:id
ADMIN_API_TOKEN=change_this_to_a_long_random_secret

# Comma-separated origin allowlist for CORS + write-origin checks
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://stageware.co.uk
